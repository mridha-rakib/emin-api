NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/emin
MONGODB_DB_NAME=emin
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me
# Comma-separated list of administrator emails (dashboard access + ID review).
# The first address is created automatically on startup with ADMIN_PASSWORD if it does not exist yet.
ADMIN_EMAIL=admin@odaboo.local
ADMIN_PASSWORD=ChangeMe123!
APP_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=change-me
SMTP_FROM="Emin <no-reply@example.com>"
# For Gmail use SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, and an app password.
# For SSL SMTP use SMTP_PORT=465 and SMTP_SECURE=true.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=eu-central-2
S3_BUCKET_NAME=your-bucket-name
# Optional: serve images from a CDN/custom domain instead of the default bucket URL.
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# Optional: canned ACL applied to uploaded images (default public-read). Use "none" when a bucket policy or CloudFront grants read access.
# S3_OBJECT_ACL=public-read
# Identity documents and selfies are always stored privately (AES-256) under identity/ and never use this ACL.

# SMS verification for Swiss mobile numbers (Twilio). Without these, development returns the code in the
# API response and logs it; production refuses to send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sender number/alphanumeric ID or a Messaging Service SID.
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
